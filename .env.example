# Chatbot Mode: "intent" (default) | "mock" | "gemini" | "ollama"
CHATBOT_MODE=intent
AI_PROVIDER=intent

# Gemini (only required if AI_PROVIDER=gemini)
GEMINI_API_KEY=

# Ollama (only required if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Supabase (optional, for future backend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
